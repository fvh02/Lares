[Unit]
Description=Lares Core
Requires=lares-speicher.service
After=lares-speicher.service docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Environment=PYTHONPATH=/opt/lares LARES_OS=1 LARES_DATA=/data LARES_RUNTIME=docker
Environment=LARES_ROOMS_DIR=/var/lib/lares/rooms LARES_CORE_HOST=lares-core
Environment=LARES_PORT=8080 LARES_HEIM_PORT=80 LARES_HEIM_TLS_PORT=443 LARES_EXTERN_PORT=8001
Environment=LARES_CORE_URL=http://lares-core:8080/api/v1
# the API and the internet gateway only for this machine and its containers; the Atrium for the home network
Environment=LARES_BIND=127.0.0.1,172.17.0.1 LARES_EXTERN_BIND=172.17.0.1 LARES_HEIM_BIND=0.0.0.0
ExecStart=/usr/bin/python3 -m lares_core
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
